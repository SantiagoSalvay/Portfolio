---
interface ExperienceItem {
  company: string;
  position: string;
  period: string;
  startDate: string;
  endDate: string;
  duration: string;
  location: string;
  remote: boolean;
  logo: string;
  description: string;
  skills: string[];
}

const experiences: ExperienceItem[] = [
  {
    company: "Pi Data Strategy & Consulting",
    position: "Intern",
    period: "Sept. 2025 - Oct. 2025",
    startDate: "2025-09",
    endDate: "2025-10",
    duration: "2 months",
    location: "Córdoba, Argentina",
    remote: true,
    logo: "/pi-data.png",
    description: "Project management and development of management skills",
    skills: ["Project Management", "Skill Development", "Planning"]
  },
  {
    company: "CEDI Tech Consulting",
    position: "Intern",
    period: "Sept. 2025 - Oct. 2025",
    startDate: "2025-09",
    endDate: "2025-10",
    duration: "2 months",
    location: "Córdoba, Argentina",
    remote: true,
    logo: "/cedi-tech.png",
    description: "Web projects development and legal practice",
    skills: ["Web Projects", "Legal Practice", "Tech Consulting"]
  },
  {
    company: "Wemox",
    position: "Intern",
    period: "Sept. 2025 - Oct. 2025",
    startDate: "2025-09",
    endDate: "2025-10",
    duration: "2 months",
    location: "Córdoba, Argentina",
    remote: true,
    logo: "/wemox.png",
    description: "Legal practice and legal services",
    skills: ["Legal Practice", "Legal Services", "Consulting"]
  },
  {
    company: "Vulps",
    position: "Intern",
    period: "Sept. 2025 - Oct. 2025",
    startDate: "2025-09",
    endDate: "2025-10",
    duration: "2 months",
    location: "Córdoba, Argentina",
    remote: true,
    logo: "/vulps.png",
    description: "Legal practice and specialized legal services",
    skills: ["Legal Practice", "Legal Services", "Legal Analysis"]
  }
];
---

<section id="experience" class="section-container scroll-animate opacity-0 translate-y-8">
  <h2 class="mb-12 text-center text-2xl font-bold tracking-tight text-white sm:mb-14 sm:text-3xl md:mb-16 md:text-4xl">Experience</h2>
  
  <div class="relative w-full">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <!-- Timeline Container -->
      <div class="relative">
        <!-- Timeline Line - Hidden on Mobile, Visible on Desktop -->
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-500 via-purple-500 to-pink-500 transform -translate-x-1/2"></div>

        <!-- Experience Items -->
        <div class="grid gap-8 sm:gap-10 md:space-y-12 md:flex md:flex-col">
          {experiences.map((exp, index) => (
            <div class={`stagger-animate opacity-0 translate-y-4 stagger-${index + 1} relative`}>
              <!-- Mobile Layout - Card Style -->
              <div class="md:hidden">
                <div class="group bg-gradient-to-br from-blue-900/30 to-purple-900/30 backdrop-blur-md rounded-2xl p-5 sm:p-6 border border-blue-500/30 hover:border-blue-400/80 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20 relative overflow-hidden">
                  <!-- Background Gradient -->
                  <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  
                  <!-- Content -->
                  <div class="relative z-10">
                    <!-- Step Number & Header -->
                    <div class="flex items-start justify-between mb-4">
                      <div class="flex items-start gap-4 flex-1">
                        {exp.logo && (
                          <img 
                            src={exp.logo} 
                            alt={exp.company}
                            class="w-14 h-14 object-contain rounded-lg bg-white/10 p-2 border border-blue-400/50 group-hover:border-blue-300 transition-colors flex-shrink-0"
                            onError={(e) => {
                              e.target.style.display = 'none';
                            }}
                          />
                        )}
                        <div class="flex-1 min-w-0">
                          <h3 class="text-lg font-bold text-white group-hover:text-blue-200 transition-colors leading-tight">{exp.company}</h3>
                          <p class="text-blue-300 font-semibold text-sm">{exp.position}</p>
                        </div>
                      </div>
                      <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center border-2 border-blue-400/50 ml-2">
                        <span class="text-white font-bold text-sm">{index + 1}</span>
                      </div>
                    </div>

                    <!-- Info Row -->
                    <div class="flex items-center gap-2 flex-wrap text-xs sm:text-sm text-gray-300 mb-3">
                      <span class="inline-flex items-center gap-1 px-2 py-1 bg-blue-500/20 rounded-full border border-blue-400/30">
                        📅 {exp.period}
                      </span>
                      <span class="inline-flex items-center gap-1 px-2 py-1 bg-purple-500/20 rounded-full border border-purple-400/30">
                        {exp.remote ? "🌐" : "📍"} {exp.location}
                      </span>
                    </div>

                    <!-- Duration -->
                    <div class="text-xs sm:text-sm text-gray-300 mb-3 px-2 py-1 bg-gray-800/50 rounded-lg border border-gray-700/50 inline-block">
                      ⏱️ {exp.duration}
                    </div>

                    <!-- Divider -->
                    <div class="h-px bg-gradient-to-r from-blue-500/30 to-purple-500/30 my-4"></div>

                    <!-- Description -->
                    <p class="text-sm text-gray-200 mb-4 leading-relaxed">{exp.description}</p>

                    <!-- Skills -->
                    <div class="flex flex-wrap gap-1.5">
                      {exp.skills.map((skill, skillIndex) => (
                        <span key={skillIndex} class="inline-block px-2.5 py-1 bg-gradient-to-r from-blue-500/30 to-purple-500/30 border border-blue-400/40 text-blue-200 text-xs rounded-full hover:from-blue-500/50 hover:to-purple-500/50 hover:border-blue-300 transition-all duration-200">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Desktop Layout -->
              <div class="hidden md:block">
                <div class={`flex ${index % 2 === 0 ? "flex-row" : "flex-row-reverse"}`}>
                  <!-- Content Area -->
                  <div class="w-1/2 px-8">
                    <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700 hover:border-blue-500/80 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20 h-full">
                      <div class="flex items-start gap-4 mb-4">
                        {exp.logo && (
                          <img 
                            src={exp.logo} 
                            alt={exp.company}
                            class="w-16 h-16 object-contain rounded-lg bg-white/10 p-2.5 border border-gray-600 group-hover:border-blue-500/50 transition-colors flex-shrink-0"
                            onError={(e) => {
                              e.target.style.display = 'none';
                            }}
                          />
                        )}
                        <div class="flex-1 min-w-0">
                          <h3 class="text-xl font-bold text-white group-hover:text-blue-300 transition-colors">{exp.company}</h3>
                          <p class="text-base text-blue-400 font-semibold">{exp.position}</p>
                        </div>
                      </div>

                      <div class="space-y-1.5 text-sm mb-4">
                        <div class="inline-flex items-center gap-2 text-gray-400 w-full">
                          <span>📅</span> {exp.period}
                        </div>
                        <div class="inline-flex items-center gap-2 text-gray-400 w-full">
                          <span>{exp.remote ? "🌐" : "📍"}</span> {exp.location}
                        </div>
                        <div class="inline-flex items-center gap-2 text-gray-400 w-full">
                          <span>⏱️</span> {exp.duration}
                        </div>
                      </div>

                      <div class="h-px bg-gradient-to-r from-blue-500/50 to-purple-500/50 my-4"></div>

                      <p class="text-base text-gray-300 mb-4">{exp.description}</p>

                      <div class="flex flex-wrap gap-2">
                        {exp.skills.map((skill, skillIndex) => (
                          <span key={skillIndex} class="inline-block px-3 py-1.5 bg-gradient-to-r from-blue-500/20 to-purple-500/20 border border-blue-400/50 text-blue-300 text-sm rounded-full hover:from-blue-500/30 hover:to-purple-500/30 hover:border-blue-400 transition-all duration-200">
                            {skill}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>

                  <!-- Dot Area -->
                  <div class="w-0 flex items-center justify-center relative z-10">
                    <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full border-4 border-gray-950 flex items-center justify-center absolute">
                      <div class="w-2 h-2 bg-white rounded-full"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .stagger-animate {
      animation: fadeInUp 0.6s ease-out forwards;
    }

    .stagger-1 { animation-delay: 0.1s; }
    .stagger-2 { animation-delay: 0.2s; }
    .stagger-3 { animation-delay: 0.3s; }
    .stagger-4 { animation-delay: 0.4s; }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(1rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  /* Smooth hover effects */
  .group {
    @apply transition-all duration-300;
  }

  .group:hover {
    @apply shadow-xl shadow-blue-500/10;
  }

  /* Timeline responsive adjustments */
  @media (max-width: 768px) {
    .group {
      @apply border-l-2 border-l-blue-500/50 pl-4;
    }
  }
</style>
